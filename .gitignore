data/*.json
reports/*.json

# Keep the data/ and reports/ directories in the repo so the relative paths work,
# but ignore everything inside them. Drop a `.gitkeep` if you want to commit the
# empty dirs:  touch data/.gitkeep reports/.gitkeep
!data/.gitkeep
!reports/.gitkeep

